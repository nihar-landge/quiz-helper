{
  "manifest_version": 3,
  "name": "Quiz Helper",
  "version": "1.0.0",
  "description": "On-device quiz answers using Apple Foundation Model. Runs entirely on your Mac.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quiz Helper"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Show answers for questions on this page"
    }
  }
}
